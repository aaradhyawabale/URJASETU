# UrjaSetu Environment Variables Example

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL / PostGIS or MongoDB)
MONGODB_URI=mongodb://localhost:27017/urjasetu
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/urjasetu

# AI Service Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Geospatial API Keys (Optional)
OPENTOPOGRAPHY_API_KEY=your_opentopography_key_here
